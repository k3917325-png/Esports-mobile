

on:
  push:
    branches: [ main ]
  workflow_dispatch: {}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Find and Extract Android Project Zip
        run: |
          # Repository ke andar jo bhi zip file hai use dhoondh kar extract karenge
          ZIP_FILE=$(find . -maxdepth 1 -name "*.zip" | head -n 1)
          if [ -n "$ZIP_FILE" ]; then
            echo "Found zip file: $ZIP_FILE. Extracting..."
            unzip -q "$ZIP_FILE" -d extracted_project
            # Agar zip ke andar folder ke andar files hain toh unhe root par layenge
            shopt -s dotglob
            mv extracted_project/*/* extracted_project/ 2>/dev/null || true
            # Saari files ko main workspace par move kar denge
            mv extracted_project/* .
            rm -rf extracted_project "$ZIP_FILE"
          else
            echo "No zip file found, checking standard project structure..."
          fi
          ls -la

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Grant execute permission to gradlew
        run: chmod +x gradlew

      - name: Decode release keystore
        run: echo "${{ secrets.RELEASE_KEYSTORE_BASE64 }}" | base64 -d > release-key.jks

      - name: Build signed release AAB
        env:
          RELEASE_KEYSTORE_PATH: ../release-key.jks
          RELEASE_KEYSTORE_PASSWORD: ${{ secrets.RELEASE_KEYSTORE_PASSWORD }}
          RELEASE_KEY_ALIAS: ${{ secrets.RELEASE_KEY_ALIAS }}
          RELEASE_KEY_PASSWORD: ${{ secrets.RELEASE_KEY_PASSWORD }}
        run: ./gradlew :app:bundleRelease --no-daemon --stacktrace

      - name: Upload AAB artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release-aab
          path: app/build/outputs/bundle/release/app-release.aab
          if-no-files-found: error

      - name: Clean up keystore from workspace
        if: always()
        run: rm -f release-key.jks
        
