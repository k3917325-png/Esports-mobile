name: Build Signed Release AAB

on:
  push:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      allow_test_config:
        description: "Allow build WITHOUT production Cloud URL / AdMob ids (test builds only - never upload to Play)"
        type: boolean
        default: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Inject production Cloud API URL + verify AdMob ids
        env:
          CLOUD_API_URL: ${{ vars.CLOUD_API_URL }}
          ADMOB_APP_ID: ${{ vars.ADMOB_APP_ID }}
          ADMOB_REWARDED_ID: ${{ vars.ADMOB_REWARDED_ID }}
          ALLOW_TEST: ${{ github.event.inputs.allow_test_config }}
        run: |
          fail() { if [ "$ALLOW_TEST" = "true" ]; then echo "::warning::$1 (test build - do NOT upload to Play)"; else echo "::error::$1"; exit 1; fi; }
          # 1) Cloud backend URL baked into the app (public URL, not a secret)
          if [[ "$CLOUD_API_URL" =~ ^https://[A-Za-z0-9._:/-]+$ ]]; then
            URL="${CLOUD_API_URL%/}"
            sed -i "s#const CLOUD_API_DEFAULT = \"[^\"]*\";#const CLOUD_API_DEFAULT = \"${URL}\";#" app/src/main/assets/index.html
            grep -q "const CLOUD_API_DEFAULT = \"${URL}\";" app/src/main/assets/index.html || { echo "::error::CLOUD_API_DEFAULT injection failed"; exit 1; }
          else
            fail "Repo variable CLOUD_API_URL missing/invalid (needs https://...)"
          fi
          # 2) AdMob production ids (public identifiers) - format check, must not be Google's test ids
          if [[ "$ADMOB_APP_ID" =~ ^ca-app-pub-[0-9]{16}~[0-9]{10}$ && "$ADMOB_APP_ID" != ca-app-pub-3940256099942544* ]]; then :; else fail "Repo variable ADMOB_APP_ID missing/invalid/test id"; fi
          if [[ "$ADMOB_REWARDED_ID" =~ ^ca-app-pub-[0-9]{16}/[0-9]{10}$ && "$ADMOB_REWARDED_ID" != ca-app-pub-3940256099942544* ]]; then :; else fail "Repo variable ADMOB_REWARDED_ID missing/invalid/test id"; fi

      - name: Grant execute permission to gradlew
        run: chmod +x gradlew

      - name: Decode release keystore
        run: echo "${{ secrets.RELEASE_KEYSTORE_BASE64 }}" | base64 -d > release-key.jks

      - name: Build signed release AAB + APK
        env:
          RELEASE_KEYSTORE_PATH: ../release-key.jks
          RELEASE_KEYSTORE_PASSWORD: ${{ secrets.RELEASE_KEYSTORE_PASSWORD }}
          RELEASE_KEY_ALIAS: ${{ secrets.RELEASE_KEY_ALIAS }}
          RELEASE_KEY_PASSWORD: ${{ secrets.RELEASE_KEY_PASSWORD }}
          ADMOB_APP_ID: ${{ vars.ADMOB_APP_ID }}
          ADMOB_REWARDED_ID: ${{ vars.ADMOB_REWARDED_ID }}
        run: ./gradlew :app:bundleRelease :app:assembleRelease --no-daemon --stacktrace

      - name: Upload AAB artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release-aab
          path: app/build/outputs/bundle/release/app-release.aab
          if-no-files-found: error

      - name: Upload APK artifact (direct install / testing)
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: app/build/outputs/apk/release/app-release.apk
          if-no-files-found: error

      - name: Clean up keystore from workspace
        if: always()
        run: rm -f release-key.jks
