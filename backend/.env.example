# Copy to .env (or set in your host's Environment settings). NEVER commit real values.
PORT=8080
DATA_FILE=./data/db.json
# Dev only: returns the OTP in the API response. Keep 0 in production.
DEV_OTP=0
# Your SMS provider endpoint + auth (server-side only, never in the app)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH=
